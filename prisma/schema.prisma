// Anonymous board — a single SQLite file living on a persistent volume.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id        Int      @id @default(autoincrement())
  nick      String   @default("anon")
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("messages")
}
